  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map(name: "deleted_at")

  @@index([partnerId])
  @@map("partner_notes")
}

model NoteEvent {
  id         String          @id @default(cuid())
  targetType NoteTargetType
  targetId   String          @map(name: "target_id")
  action     NoteEventAction

  actorId String @map(name: "actor_id")
  actor   Person @relation("NoteEventActor", fields: [actorId], references: [id])

