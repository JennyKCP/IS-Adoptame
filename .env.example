# OPCIONAL: oculta mensajes informativos de dotenv.
DOTENV_CONFIG_QUIET=true

# OBLIGATORIO: secreto para firmar las sesiones.
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# OBLIGATORIO: URL local o URL pública de la aplicación.
BETTER_AUTH_URL="http://localhost:3000"

# OBLIGATORIO: hosts permitidos por Better Auth.
BETTER_AUTH_ALLOWED_HOSTS="localhost:*"

# OBLIGATORIO: contraseña usada por la cuenta admin del seed.
ADMIN_PASSWORD=""

# OPCIONAL: necesario solo para subir y gestionar imágenes.
BLOB_READ_WRITE_TOKEN=""

# OPCIONAL: habilita inicio de sesión con GitHub.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# OPCIONAL: habilita inicio de sesión con Google.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""



# OBLIGATORIO: conexión pooled de Neon. El host normalmente contiene -pooler.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST-POOLER.neon.tech/BASE?sslmode=require"

# OBLIGATORIO: conexión directa de Neon, sin -pooler. Prisma la usa para
# sincronizar el esquema y ejecutar el seed.
DATABASE_URL_UNPOOLED="postgresql://USUARIO:CONTRASENA@HOST.neon.tech/BASE?sslmode=require"



# OPCIONAL: valores por defecto del refugio.
SHELTER_TIMEZONE="America/New_York"
WEIGHT_UNIT_SYSTEM="metric"
DEFAULT_PHONE_COUNTRY="US"

# OPCIONAL: configuración de demo.
NEXT_PUBLIC_IS_DEMO=false
CRON_SECRET=""

# OPCIONAL: habilita el asistente de IA.
GROQ_API_KEY=""
AI_PROVIDER_TIER="free"

# OBLIGATORIO solo si la IA utiliza herramientas que modifican datos.
# Generar con: openssl rand -base64 32
AI_TOOL_APPROVAL_SECRET=""
